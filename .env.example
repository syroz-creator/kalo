# Set GEMINI_API_KEY in Render's Environment settings, or in a local .env file.
# Keep the key on the server; never use a VITE_ prefix for it.
GEMINI_API_KEY=""

# Direct contact delivery. Keep this key on the server, without a VITE_ prefix.
# https://resend.com/api-keys
RESEND_API_KEY=""
CONTACT_TO_EMAIL="uwaidaahmad@gmail.com"
# The default Resend sender can send only to your Resend account's email address.
# Register Resend with the inbox above, or use a sender on your verified domain.
CONTACT_FROM_EMAIL="Kalo <onboarding@resend.dev>"

# Optional model override. Without one, scanning can select an available Flash
# model if the default model is unavailable for your API key.
