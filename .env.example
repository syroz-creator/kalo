# Set GEMINI_API_KEY in Render's Environment settings, or in a local .env file.
# Keep the key on the server; never use a VITE_ prefix for it.
GEMINI_API_KEY=""

# Optional model override. Without one, scanning can select an available Flash
# model if the default model is unavailable for your API key.
# GEMINI_MODEL="gemini-3.8-flash"
